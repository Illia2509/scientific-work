# Скопіюйте цей файл у .env і змініть значення. Файл .env не потрапляє в Git.

# Режим розробки: True лише локально
DEBUG=True
# Згенеруйте власний ключ:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change_me
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost

# PostgreSQL (сервіс db у docker-compose)
DB_NAME=med_platform
DB_USER=postgres
DB_PASSWORD=change_me_db_password
DB_HOST=db
DB_PORT=5432

# Резервне копіювання: скільки днів зберігати копії
BACKUP_KEEP_DAYS=7
